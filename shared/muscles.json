{
  "version": 2,
  "doc": "Team contract. exercise_key -> muscles, muscle labels, Brodie plan names, and the scoring rule. Used by the worker (shared/scoring.py) and web/.",

  "muscles": {
    "quads":      {"label": "Quads",       "view": "front"},
    "glutes":     {"label": "Glutes",      "view": "back"},
    "hamstrings": {"label": "Hamstrings",  "view": "back"},
    "calves":     {"label": "Calves",      "view": "back"},
    "adductors":  {"label": "Adductors",   "view": "front"},
    "abductors":  {"label": "Abductors",   "view": "both"},
    "chest":      {"label": "Chest",       "view": "front"},
    "front_delts":{"label": "Front delts", "view": "front"},
    "triceps":    {"label": "Triceps",     "view": "back"},
    "biceps":     {"label": "Biceps",      "view": "front"},
    "forearms":   {"label": "Forearms",    "view": "both"},
    "abs":        {"label": "Abs",         "view": "front"},
    "obliques":   {"label": "Obliques",    "view": "front"},
    "lats":       {"label": "Lats",        "view": "back"},
    "traps":      {"label": "Traps",       "view": "both"},
    "rear_delts": {"label": "Rear delts",  "view": "back"}
  },

  "exercises": {
    "squat":        {"name": "Squats",        "plan_name": "squats",        "primary": ["quads", "glutes"],          "secondary": ["hamstrings", "adductors", "abs"]},
    "pushup":       {"name": "Push-ups",      "plan_name": "pushups",       "primary": ["chest", "triceps"],         "secondary": ["front_delts", "abs"]},
    "lunge":        {"name": "Lunges",        "plan_name": "lunges",        "primary": ["quads", "glutes"],          "secondary": ["hamstrings", "adductors", "calves"]},
    "jumping_jack": {"name": "Jumping jacks", "plan_name": "jumping jacks", "primary": ["calves", "front_delts"],    "secondary": ["quads", "glutes", "adductors"]},
    "bicep_curl":   {"name": "Bicep curls",   "plan_name": "bicep curls",   "primary": ["biceps"],                   "secondary": ["forearms", "front_delts"]},
    "pullup":       {"name": "Pull-ups",      "plan_name": "pull ups",      "primary": ["lats", "biceps"],           "secondary": ["rear_delts", "forearms", "traps", "abs"]}
  },

  "fault_prefix": {"doc": "Brodie fault labels start with the classifier name, which differs from the plan name for lunges",
                   "squat": "squats", "pushup": "pushups", "lunge": "alternating forward lunges", "jumping_jack": "jumping jacks", "bicep_curl": "bicep curls", "pullup": "pull ups"},

  "scoring": {
    "doc": [
      "Per exercise (all its sets in the session): completed = reps counted, planned = sum of planned reps, clean = reps with no faults / completed (0 if completed is 0).",
      "  completion = min(completed / planned, 1)",
      "  dropoff    = max(0, clean rate of the first set - clean rate of the last set)   (0 with one set)",
      "  quality    = 0.5 * clean + 0.3 * completion + 0.2 * (1 - dropoff)",
      "Per muscle: weighted average of quality over the exercises that hit it (primary weight 1, secondary 0.5); coverage = primary if any hitting exercise lists it as primary, else secondary.",
      "Color: score >= 0.75 green, >= 0.5 yellow, else red. A muscle no exercise hit: score 0, color gray, coverage none, label 'not trained this session'.",
      "An exercise with 0 completed reps does not hit any muscle (its muscles stay gray unless another exercise hits them)."
    ],
    "weights": {"clean": 0.5, "completion": 0.3, "dropoff": 0.2},
    "role_weights": {"primary": 1.0, "secondary": 0.5},
    "thresholds": {"green_min": 0.75, "yellow_min": 0.5},
    "colors": {"green": "#22c55e", "yellow": "#eab308", "red": "#ef4444", "gray": "#9ca3af"},
    "gray_label": "not trained this session"
  }
}
