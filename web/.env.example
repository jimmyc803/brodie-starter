# Copy to web/.env.local and fill in. Never commit .env.local. On Vercel, set these under Project Settings > Environment Variables.
# Server only: do not rename these with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Coach emails (sign-up link, approval, "Email me my link" at /link). Optional: without RESEND_API_KEY no email is sent.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Brodie <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Public origin used in emailed links, e.g. https://brodie-for-coaches.vercel.app (defaults to the request's host).
SITE_URL=
