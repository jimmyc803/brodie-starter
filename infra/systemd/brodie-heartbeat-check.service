[Unit]
Description=Brodie health and heartbeat monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
OnFailure=brodie-alert@%n.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/brodie
Environment=AWS_DEFAULT_REGION=us-east-1
EnvironmentFile=/etc/brodie/env
Environment=PYTHONPATH=src:.
Environment=PATH=/opt/brodie/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/root
ExecStart=/bin/bash /opt/brodie/infra/heartbeat.sh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
UMask=0077
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
