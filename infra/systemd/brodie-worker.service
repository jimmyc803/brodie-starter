[Unit]
Description=Brodie competition worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
OnFailure=brodie-alert@%n.service

[Service]
Type=simple
User=brodie
WorkingDirectory=/opt/brodie/current
Environment=AWS_DEFAULT_REGION=us-east-1
EnvironmentFile=/etc/brodie/env
Environment=PYTHONPATH=src:.
Environment=PATH=/opt/brodie/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/brodie
ExecStart=/opt/brodie/current/.venv/bin/python -m facetime.worker start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
UMask=0077
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
