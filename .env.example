LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>
AGENT_NAME=
GEMINI_API_KEY=<team token from your card>
GEMINI_BASE_URL=https://james-72765--rtcoach-gemini.modal.run

# Challenge deployment variables (set values in SSM, never commit secrets).
CALLER_ID_SOURCE=
MESSAGING_PROVIDER=
HANGUP_MODE=
# Only for HANGUP_MODE=chert_api (names only; set the values in SSM, never here):
CHERT_FACETIME_TOKEN=
CHERT_PROJECT_ID=
REVEAL_MODE=
# Only for REVEAL_MODE=video: site origin used to fetch /r/<call_id>/card (name only; value in SSM):
WEB_BASE_URL=
CARD_DELIVERY=
LINE_OFFLINE_GAP_S=
OUTBOUND_RATE_PER_MIN=
DISPATCHER_URL=
DISPATCHER_TOKEN=
CHALLENGE_MODE=
LINE_ID=
SUPABASE_DB_URL=
BACKUP_BUCKET=
HC_WORKER_URL=
HC_DISPATCHER_URL=
CHERT_TOKEN_EXPIRES_AT=
OUTBOUND_FAILURE_ALERT_COUNT=
ALERT_EMAIL=
SES_FROM_EMAIL=
AWS_DEFAULT_REGION=
TEAM_SSH_CIDRS=
SSH_PUBLIC_KEY_FILE=
INSTANCE_TYPE=
SSM_PREFIX=
SSM_KMS_KEY_ARN=
DOMAIN=
PUBLIC_IP=
REPO_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 in production: Caddy fronts the dispatcher, so the client IP comes from X-Forwarded-For.
TRUSTED_PROXY=1
# Required in production: secret salt for power-hour selection (keeps it unguessable).
POWER_HOUR_SECRET=
# Optional override; default recipients come from config key team_alert_handles.
ADMIN_ALERT_HANDLES=
JOBS_ENABLED=1
CHALLENGE_ALLOW_MOCK_WEBHOOK=0
# Web-only join (task 44): issuer is always required, e.g. https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
WEB_RATE_PER_USER_MIN=120
# per-IP cap for /web (all traffic arrives from Vercel); other scopes use DISPATCHER_RATE_PER_MIN
DISPATCHER_RATE_PER_MIN_WEB=20000
# Web-only join from the site (MESSAGING_PROVIDER=web_only fallback); site flag NEXT_PUBLIC_WEB_JOIN in Vercel
WEB_JOIN_ENABLED=0
